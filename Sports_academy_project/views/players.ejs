<%- include('partials/header') %>

<section class="page-header">
  <div>
    <p class="eyebrow">Manage</p>
    <h2>Players</h2>
  </div>
  <a class="btn primary" href="/players/add">Add Player</a>
</section>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Player Name</th>
        <th>Position</th>
        <th>Team</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% players.forEach(player => { %>
        <tr>
          <td><%= player.PLY_ID %></td>
          <td><%= player.PLY_NAME %></td>
          <td><%= player.POSITION %></td>
          <td><%= player.TEAM_NAME %></td>
          <td class="actions">
            <a href="/players/edit/<%= player.PLY_ID %>">Edit</a>
            <a class="danger delete-link" href="/players/delete/<%= player.PLY_ID %>">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
