<%- include('partials/header') %>

<section class="page-header">
  <div>
    <p class="eyebrow">Players</p>
    <h2><%= player ? 'Edit Player' : 'Add Player' %></h2>
  </div>
</section>

<form class="form-card" method="POST" action="<%= formAction %>">
  <label>Player Name
    <input type="text" name="PLY_NAME" value="<%= player ? player.PLY_NAME : '' %>" required>
  </label>
  <label>Position
    <input type="text" name="POSITION" value="<%= player ? player.POSITION : '' %>" required>
  </label>
  <label>Team
    <select name="TEAM_ID" required>
      <option value="">Select Team</option>
      <% teams.forEach(team => { %>
        <option value="<%= team.TEAM_ID %>" <%= player && player.TEAM_ID === team.TEAM_ID ? 'selected' : '' %>>
          <%= team.TEAM_NAME %>
        </option>
      <% }) %>
    </select>
  </label>
  <div class="form-actions">
    <button class="btn primary" type="submit">Save</button>
    <a class="btn secondary" href="/players">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
