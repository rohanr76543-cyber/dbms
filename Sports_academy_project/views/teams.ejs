<%- include('partials/header') %>

<section class="page-header">
  <div>
    <p class="eyebrow">Manage</p>
    <h2>Teams</h2>
  </div>
  <a class="btn primary" href="/teams/add">Add Team</a>
</section>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Team Name</th>
        <th>Coach Name</th>
        <th>Home Ground</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% teams.forEach(team => { %>
        <tr>
          <td><%= team.TEAM_ID %></td>
          <td><%= team.TEAM_NAME %></td>
          <td><%= team.COACH_NAME %></td>
          <td><%= team.HOME_GROUND %></td>
          <td class="actions">
            <a href="/teams/edit/<%= team.TEAM_ID %>">Edit</a>
            <a class="danger delete-link" href="/teams/delete/<%= team.TEAM_ID %>">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
