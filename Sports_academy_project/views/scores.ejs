<%- include('partials/header') %>

<section class="page-header">
  <div>
    <p class="eyebrow">Manage</p>
    <h2>Scores</h2>
  </div>
  <a class="btn primary" href="/scores/add">Add Score</a>
</section>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Match ID</th>
        <th>Match</th>
        <th>Home Score</th>
        <th>Away Score</th>
        <th>Win Team</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% scores.forEach(score => { %>
        <tr>
          <td><%= score.MATCH_ID %></td>
          <td><%= score.HOME_TEAM %> vs <%= score.AWAY_TEAM %></td>
          <td><%= score.HOME_SCORE %></td>
          <td><%= score.AWAY_SCORE %></td>
          <td><%= score.WIN_TEAM %></td>
          <td class="actions">
            <a href="/scores/edit/<%= score.MATCH_ID %>">Edit</a>
            <a class="danger delete-link" href="/scores/delete/<%= score.MATCH_ID %>">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
