<%- include('partials/header') %>

<section class="page-header">
  <div>
    <p class="eyebrow">Manage</p>
    <h2>Coaches</h2>
  </div>
  <a class="btn primary" href="/coaches/add">Add Coach</a>
</section>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Coach Name</th>
        <th>Experience</th>
        <th>Age</th>
        <th>Team</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% coaches.forEach(coach => { %>
        <tr>
          <td><%= coach.COACH_ID %></td>
          <td><%= coach.COACH_NAME %></td>
          <td><%= coach.EXPERIENCE %></td>
          <td><%= coach.COACH_AGE %></td>
          <td><%= coach.TEAM_NAME %></td>
          <td class="actions">
            <a href="/coaches/edit/<%= coach.COACH_ID %>">Edit</a>
            <a class="danger delete-link" href="/coaches/delete/<%= coach.COACH_ID %>">Delete</a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
